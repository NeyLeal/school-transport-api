@page "/equipe"
@inject ApiClient Api

<section class="pagina">
    <header class="cabecalho-pagina">
        <div>
            <h1>Equipe</h1>
            <p class="apoio">Ajudantes que acompanham as crianças na van.</p>
        </div>
    </header>

    <EditForm Model="_modelo" OnValidSubmit="AdicionarAsync" class="formulario-inline" FormName="ajudante">
        <label class="campo">
            <span>Nome</span>
            <InputText @bind-Value="_modelo.Nome" required />
        </label>
        <label class="campo">
            <span>Telefone</span>
            <InputText type="tel" @bind-Value="_modelo.Telefone" required />
        </label>
        <div class="acoes-formulario">
            <button class="botao-primario" type="submit" disabled="@_ocupado">Adicionar ajudante</button>
        </div>
    </EditForm>

    <Aviso Mensagem="@_erro" />

    @if (_ajudantes is { Count: 0 })
    {
        <div class="vazio"><p>Nenhum ajudante cadastrado.</p></div>
    }
    else if (_ajudantes is not null)
    {
        <ul class="lista-simples">
            @foreach (var ajudante in _ajudantes)
            {
                <li>
                    <div>
                        <strong>@ajudante.Nome</strong>
                        <span class="apoio">@ajudante.Telefone</span>
                        @if (ajudante.PossuiAcesso)
                        {
                            <span class="selo">Usa o app</span>
                        }
                    </div>
                    <div class="acoes-item">
                        @if (!ajudante.PossuiAcesso)
                        {
                            <button class="botao-texto" @onclick="() => AbrirAcesso(ajudante)">Liberar acesso</button>
                        }
                        <button class="botao-texto perigo" @onclick="() => RemoverAsync(ajudante.Id)">Remover</button>
                    </div>
                    @if (_acessoPara?.Id == ajudante.Id)
                    {
                        <form class="acesso" @onsubmit="LiberarAcessoAsync" @onsubmit:preventDefault>
                            <p class="apoio">Com acesso, @ajudante.Nome registra embarque e desembarque das crianças.</p>
                            <label class="campo">
                                <span>E-mail de login</span>
                                <input type="email" @bind="_acesso.Email" required autocomplete="off" />
                            </label>
                            <label class="campo">
                                <span>Senha inicial</span>
                                <input type="password" @bind="_acesso.Senha" minlength="6" required autocomplete="new-password" />
                            </label>
                            <div class="acoes-formulario">
                                <button class="botao-primario" type="submit" disabled="@_ocupado">Liberar acesso</button>
                                <button class="botao-texto" type="button" @onclick="() => _acessoPara = null">Cancelar</button>
                            </div>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    private AjudanteRequest _modelo = new();
    private List<AjudanteResponse>? _ajudantes;
    private AjudanteResponse? _acessoPara;
    private CriarAcessoAjudanteRequest _acesso = new();
    private string? _erro;
    private bool _ocupado;

    private void AbrirAcesso(AjudanteResponse ajudante)
    {
        _acessoPara = ajudante;
        _acesso = new CriarAcessoAjudanteRequest();
    }

    private Task LiberarAcessoAsync() => ExecutarAsync(async () =>
    {
        await Api.CriarAcessoAjudanteAsync(_acessoPara!.Id, _acesso);
        _acessoPara = null;
        _acesso = new CriarAcessoAjudanteRequest();
        _ajudantes = await Api.ListarAjudantesAsync();
    });

    protected override Task OnInitializedAsync() => ExecutarAsync(async () => _ajudantes = await Api.ListarAjudantesAsync());

    private Task AdicionarAsync() => ExecutarAsync(async () =>
    {
        await Api.AdicionarAjudanteAsync(_modelo);
        _modelo = new AjudanteRequest();
        _ajudantes = await Api.ListarAjudantesAsync();
    });

    private Task RemoverAsync(Guid id) => ExecutarAsync(async () =>
    {
        await Api.RemoverAjudanteAsync(id);
        _ajudantes = await Api.ListarAjudantesAsync();
    });

    private async Task ExecutarAsync(Func<Task> acao)
    {
        _erro = null;
        _ocupado = true;

        try
        {
            await acao();
        }
        catch (ApiException ex)
        {
            _erro = ex.Message;
        }
        finally
        {
            _ocupado = false;
        }
    }
}
